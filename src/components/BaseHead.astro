---
// Imported here so global.css lands on every page that renders a <BaseHead />.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description?: string;
	image?: ImageMetadata;
	/** Set on blog posts so we emit article metadata and BlogPosting JSON-LD. */
	article?: {
		pubDate: Date;
		updatedDate?: Date;
		tags?: string[];
	};
}

const {
	title,
	description = SITE_DESCRIPTION,
	image,
	article,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = image ? new URL(image.src, Astro.site) : undefined;
// The home page title is already the site name; don't repeat it.
const fullTitle = title === SITE_TITLE ? title : `${title} — ${SITE_TITLE}`;

const jsonLd = article
	? {
			'@context': 'https://schema.org',
			'@type': 'BlogPosting',
			headline: title,
			description,
			datePublished: article.pubDate.toISOString(),
			...(article.updatedDate && { dateModified: article.updatedDate.toISOString() }),
			...(article.tags?.length && { keywords: article.tags.join(', ') }),
			...(imageURL && { image: imageURL.href }),
			author: { '@type': 'Person', name: AUTHOR.name, url: new URL('/about/', Astro.site).href },
			publisher: { '@type': 'Person', name: AUTHOR.name },
			mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
		}
	: {
			'@context': 'https://schema.org',
			'@type': 'WebSite',
			name: SITE_TITLE,
			description: SITE_DESCRIPTION,
			url: new URL('/', Astro.site).href,
			author: { '@type': 'Person', name: AUTHOR.name, url: AUTHOR.github },
		};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="light dark" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonicalURL} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={AUTHOR.name} />

<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{imageURL && <meta property="og:image" content={imageURL} />}

{
	article && (
		<>
			<meta property="article:published_time" content={article.pubDate.toISOString()} />
			{article.updatedDate && (
				<meta property="article:modified_time" content={article.updatedDate.toISOString()} />
			)}
			{article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
		</>
	)
}

<meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
