---
import FormattedDate from './FormattedDate.astro';
import { postUrl, type Post } from '../lib/posts';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
---

<ul class="posts">
	{
		posts.map((post) => (
			<li>
				<a class="title" href={postUrl(post)}>
					{post.data.title}
				</a>
				<p class="meta muted">
					<FormattedDate date={post.data.pubDate} />
					{post.data.draft && <span class="draft">draft</span>}
				</p>
				<p class="summary">{post.data.description}</p>
			</li>
		))
	}
</ul>

<style>
	.posts {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.posts > li {
		margin: 0 0 2rem;
	}
	.title {
		font-size: 1.15rem;
		font-weight: 650;
		letter-spacing: -0.01em;
		text-decoration: none;
	}
	.title:hover {
		text-decoration: underline;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0.15rem 0 0.35rem;
		font-size: 0.85rem;
	}
	.draft {
		padding: 0 0.4rem;
		border: 1px solid var(--border);
		border-radius: 4px;
		font-size: 0.72rem;
		text-transform: uppercase;
	}
	.summary {
		margin: 0;
	}
</style>
